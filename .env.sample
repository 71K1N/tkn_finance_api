# Copy to .env and fill in real values. Do not commit .env.

PORT=8081
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
GROQ_API_KEY=

# --- Authentication ---
# Required: the API refuses to start without these two.
JWT_SECRET= 
GOOGLE_CLIENT_ID=

# Token lifetimes (units: s, m, h, d)
JWT_ACCESS_TTL=15m
REFRESH_TTL=7d
REFRESH_ABSOLUTE_TTL=30d

# Sign-up policy: "allowlist" only lets ALLOWED_EMAILS create accounts, "open" lets anyone.
SIGNUP_MODE=allowlist
ALLOWED_EMAILS=d71k1n@gmail.com
# Pre-provisioned user id 1 (owner of existing data), linked on first Google sign-in
HEIR_EMAIL=d71k1n@gmail.com

# Comma-separated browser origins allowed to send credentialed requests
CORS_ORIGINS=http://localhost:3000
# Browser-visible path of the refresh cookie (nginx strips /api, the browser does not)
COOKIE_PATH=/api/auth
# Defaults to true when NODE_ENV=production; set false when serving over plain http
COOKIE_SECURE=false
